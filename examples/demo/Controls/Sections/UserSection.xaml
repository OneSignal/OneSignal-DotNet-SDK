<?xml version="1.0" encoding="utf-8" ?>
<ContentView
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
  x:Class="OneSignalDemo.Controls.Sections.UserSection"
  x:Name="root"
>
  <VerticalStackLayout Spacing="8" AutomationId="user_section">
    <!-- Section header -->
    <Label Text="USER" Style="{StaticResource SectionHeaderStyle}" Padding="4,0,0,0" />

    <!-- User status card -->
    <Border Style="{StaticResource CardBorderStyle}">
      <VerticalStackLayout>
        <Grid Padding="12" ColumnDefinitions="*,Auto">
          <Label
            Grid.Column="0"
            Text="Status"
            Style="{StaticResource BodyMediumStyle}"
            VerticalOptions="Center"
          />
          <Label
            Grid.Column="1"
            x:Name="StatusLabel"
            Text="Anonymous"
            Style="{StaticResource BodySmallStyle}"
            FontFamily="DroidSansMono"
            VerticalOptions="Center"
            AutomationId="user_status_value"
          />
        </Grid>
        <BoxView HeightRequest="1" Color="{StaticResource OsDivider}" Margin="12,0" />
        <Grid Padding="12" ColumnDefinitions="*,Auto">
          <Label
            Grid.Column="0"
            Text="External ID"
            Style="{StaticResource BodyMediumStyle}"
            VerticalOptions="Center"
          />
          <Label
            Grid.Column="1"
            x:Name="ExternalIdLabel"
            Text="—"
            Style="{StaticResource BodySmallStyle}"
            FontFamily="DroidSansMono"
            VerticalOptions="Center"
            AutomationId="user_external_id_value"
          />
        </Grid>
        <BoxView HeightRequest="1" Color="{StaticResource OsDivider}" Margin="12,0" />
        <Grid Padding="12,4" ColumnDefinitions="*,Auto">
          <Label
            Grid.Column="0"
            Text="Language"
            Style="{StaticResource BodyMediumStyle}"
            VerticalOptions="Center"
          />
          <HorizontalStackLayout
            x:Name="LanguageDropdown"
            Grid.Column="1"
            Spacing="2"
            Padding="8,8,0,8"
            VerticalOptions="Center"
            AutomationId="user_language_dropdown"
          >
            <HorizontalStackLayout.GestureRecognizers>
              <TapGestureRecognizer Tapped="OnLanguageTapped" />
            </HorizontalStackLayout.GestureRecognizers>
            <Label
              x:Name="LanguageLabel"
              Style="{StaticResource BodySmallStyle}"
              VerticalOptions="Center"
              AutomationId="user_language_value"
            />
            <Image
              Source="{mi:Material Icon=ArrowDropDown, IconSize=20, IconColor=#757575}"
              VerticalOptions="Center"
            />
          </HorizontalStackLayout>
        </Grid>
      </VerticalStackLayout>
    </Border>

    <!-- Login/Logout buttons -->
    <Button
      x:Name="LoginButton"
      Text="LOGIN USER"
      Style="{StaticResource PrimaryButtonStyle}"
      Clicked="OnLoginClicked"
      AutomationId="login_user_button"
    />
    <Button
      x:Name="LogoutButton"
      Text="LOGOUT USER"
      Style="{StaticResource OutlineButtonStyle}"
      IsVisible="False"
      Clicked="OnLogoutClicked"
      AutomationId="logout_user_button"
    />
  </VerticalStackLayout>
</ContentView>
