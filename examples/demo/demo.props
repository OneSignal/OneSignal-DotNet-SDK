<Project>
  <!--
    Shared by demo.csproj and the NSE. E2E passes
    -p:DEMO_BUNDLE_ID=com.onesignal.sdkdemo -p:DEMO_TEAM_ID=DL8TF3X4K3, which
    MSBuild forwards to referenced projects; that bundle ID is registered to the
    enterprise team only.
  -->
  <PropertyGroup>
    <DEMO_BUNDLE_ID Condition="'$(DEMO_BUNDLE_ID)' == ''">com.onesignal.example</DEMO_BUNDLE_ID>
    <DEMO_TEAM_ID Condition="'$(DEMO_TEAM_ID)' == ''">99SW8E36CT</DEMO_TEAM_ID>
    <IsDemoDeviceBuild Condition="$(RuntimeIdentifier.StartsWith('ios-'))">true</IsDemoDeviceBuild>
    <IsDemoE2ESigning
      Condition="'$(IsDemoDeviceBuild)' == 'true' AND '$(DEMO_BUNDLE_ID)' == 'com.onesignal.sdkdemo'"
      >true</IsDemoE2ESigning>
  </PropertyGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
    <CustomEntitlements
      Include="com.apple.security.application-groups"
      Type="StringArray"
      Value="group.$(DEMO_BUNDLE_ID).onesignal"
    />
  </ItemGroup>

  <!--
    Incremental iOS builds don't relink when only the bundle ID changes, so the
    binary keeps the old application-identifier entitlement and Web Inspector
    (and Appium's WEBVIEW contexts) ignores the app. Start clean when it changes.
  -->
  <Target
    Name="CleanOnDemoBundleIdChange"
    BeforeTargets="PrepareForBuild"
    Condition="$(TargetFramework.Contains('-ios'))"
  >
    <PropertyGroup>
      <_DemoBundleIdStamp>$(IntermediateOutputPath)demo-bundle-id.txt</_DemoBundleIdStamp>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_DemoBundleIdStamp)" Condition="Exists('$(_DemoBundleIdStamp)')">
      <Output TaskParameter="Lines" PropertyName="_DemoLastBundleId" />
    </ReadLinesFromFile>
    <RemoveDir
      Directories="$(IntermediateOutputPath);$(OutputPath)"
      Condition="'$(_DemoLastBundleId)' != '$(ApplicationId)' AND Exists('$(IntermediateOutputPath)')"
    />
    <WriteLinesToFile File="$(_DemoBundleIdStamp)" Lines="$(ApplicationId)" Overwrite="true" />
  </Target>
</Project>
